# Copy to .env and edit. Everything is optional for local use.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Free AI (Google Gemini free tier). Get a key at https://aistudio.google.com/apikey
# Leave empty to use the built-in local analyzer (no AI calls, fully offline).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
